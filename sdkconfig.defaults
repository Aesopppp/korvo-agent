# ===============================================================
# Korvo Agent — sdkconfig.defaults
# 目标硬件: ESP32-S3-WROOM-1 N8R8 (8MB Flash + 8MB PSRAM Octal)
# 框架    : ESP-IDF v5.4.4
# ===============================================================

# ── 芯片与分区 ──────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_HEADER_OVERRIDE="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_APP_OFFSET=0x10000

# ── PSRAM ───────────────────────────────────────────────────
CONFIG_ESP32S3_RTOS_DATA_OCRAM_BSS_OCRAM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=y

# ── FreeRTOS ────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_TASK_FUNCTION_WRAPPER=y
CONFIG_FREERTOS_NO_AFFINITY=0x7FFFFFFF
CONFIG_FREERTOS_TICK_SUPPORT_SYSTIMER=y
CONFIG_FREERTOS_SYSTICK_USES_SYSTIMER=y

# ── 系统 ────────────────────────────────────────────────────
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_SYSTEM_EVENT_QUEUE_SIZE=32
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIME_FUNCS_IMPL_USING_TIMER=y

# ── Wi-Fi ───────────────────────────────────────────────────
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STA_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_ENABLED=n
CONFIG_ESP_WIFI_SCAN_METHOD=ALL_CHANNEL_SCAN
CONFIG_ESP_WIFI_CONNECT_TIMEOUT=30
CONFIG_ESP_WIFI_RECONNECT_TIMEOUT=10
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE=1
CONFIG_WPA_MBEDTLS_CRYPTO=y

# ── 蓝牙（不使用，禁用以节省空间）───────────────────────────
CONFIG_BT_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# ── 日志 ────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y
CONFIG_LOG_TAG_LEVEL_IMPL_DETECT_INCOMPATIBLE=y

# ── lwIP ────────────────────────────────────────────────────
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCP_QUEUE_OOSEQ=y
CONFIG_LWIP_MAX_UDP_PCBS=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=n
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y

# ── NVS ─────────────────────────────────────────────────────
# CONFIG_NVS_ENCRYPTION is not set
CONFIG_NVS_COMPAT_PREINITIALIZED=n

# ── SPI Flash ───────────────────────────────────────────────
CONFIG_SPI_FLASH_ERASE_YIELD_DURATION_MS=20
CONFIG_SPI_FLASH_ERASE_YIELD_TICKS=2
CONFIG_SPI_FLASH_DANGEROUS_PRINTS=LOG_LOCAL_LEVEL
CONFIG_SPI_FLASH_BROWNOUT_RESET=y
CONFIG_SPI_FLASH_VDD_REGULATOR_MODE_EXTERNAL=y

# ── ESP HTTP Client ─────────────────────────────────────────
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_HTTP_CLIENT_CONN_POOL_MAX_SIZE=8

# ── WebSocket (esp_websocket_client) ────────────────────────
CONFIG_ESP_WEBSOCKET_CLIENT_NONE=y
# 手动实现 ws_service.c，不依赖 esp_websocket_client

# ── esp_codec_dev ────────────────────────────────────────────
CONFIG_ESP_CODEC_DEV_OVERRIDE_BSP=n
CONFIG_ESP_CODEC_DEV_LOOPBACK=n

# ── Board Selection ──────────────────────────────────────────
# V3.0 / V3.1.2 共用同一 BSP (V3.0 板级定义)
CONFIG_ESP32_S3_KORVO_2_V3_0_BOARD=y

# ── Driver ─────────────────────────────────────────────────
CONFIG_I2S_ENABLE_DEBUG_LOG=n
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# ── eFuse / Secure Boot ─────────────────────────────────────
CONFIG_ESP_SECURE_CERT_MAX_SIZE=4096
CONFIG_SECURE_BOOT_SUPPORTS_RSA=y

# ── 超时与 Watchdog ─────────────────────────────────────────
CONFIG_ESP_SYSTEM_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# ── VFS / UART ──────────────────────────────────────────────
CONFIG_VFS_SUPPORT=y
CONFIG_VFS_SUPPORT_UART=y
CONFIG_UART_ISR_IN_IRAM=y

# ── mDNS ────────────────────────────────────────────────────
CONFIG_MDNS_ENABLED=n

# ── esp_timer ───────────────────────────────────────────────
CONFIG_ESP_TIMER_PROFILING=n
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# ── Heap ────────────────────────────────────────────────────
CONFIG_HEAP_PLACE_ASSERTIONS=y
CONFIG_HEAP_ABORT_WHEN_ALLOCATION_FAILS=n
CONFIG_HEAP_TASK_TRACE_ENABLED=n
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y

# ── Coredump ────────────────────────────────────────────────
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=n
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=n
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

# ── FAT Filesystem (不使用，禁用)────────────────────────────
CONFIG_FATFS_CODEPAGE_DYNAMIC=n
CONFIG_FATFS_USE_LABEL=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y
CONFIG_SPIRAM_MODE_OCT=y

# Real-time full-duplex audio: keep these defaults on a fresh configure.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
